# Windows: si ves "fetch failed" en dev, el script npm run dev ya usa
# NODE_OPTIONS=--use-system-ca vía cross-env.

# Públicas (cliente)
# Local: http://localhost:3000
# Producción (Vercel): https://makingcode-delta.vercel.app — OBLIGATORIO en prod (SEO, OG, share)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Requerido para login (Auth API): anon JWT del dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo servidor — NUNCA exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Bucket público de Storage (default: makingcode)
SUPABASE_STORAGE_BUCKET=makingcode
REVALIDATE_SECRET=generate-a-long-random-string

# Analytics — first-party (free, Supabase). Optional third-party script below.
# Tracking runs automatically via /api/analytics/view after migration 20260622000000_page_view_events.sql
# Optional Plausible/Umami script (paid or self-hosted) — leave unset to use first-party only
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
# Umami (self-hosted): set website id + script URL
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Giscus comments (optional — enable GitHub Discussions on the repo first)
# NEXT_PUBLIC_GISCUS_REPO=AndresED/makingcode
# NEXT_PUBLIC_GISCUS_REPO_ID=
# NEXT_PUBLIC_GISCUS_CATEGORY=Comments
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# EmailJS — welcome email to subscriber (same service/key as portafolio-2026)
# Template To Email: {{to_email}} | include footer link: {{unsubscribe_url}} ({{unsubscribe_text}})
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_NEWSLETTER_WELCOME_TEMPLATE_ID=
