{
  "name": "makingcode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:posts": "npx tsx scripts/seed-blog-posts.mjs",
    "seed:covers": "npx tsx scripts/seed-blog-posts.mjs -- --covers-only",
    "fonts:download": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-fonts.ps1",
    "seed:publicaciones": "npx tsx scripts/seed-publicaciones.mjs",
    "patch:seo": "node scripts/patch-production-seo.mjs",
    "patch:covers": "node scripts/patch-production-seo.mjs -- --covers-only"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "shiki": "^4.2.0",
    "undici": "^8.4.1",
    "unified": "^11.0.5",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
